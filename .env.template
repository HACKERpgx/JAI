# Web Scraping API Keys
# These are optional - the app works with free scraping methods by default

# OpenWeatherMap API Key (for weather data)
# Get your free API key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# SerpAPI Key (for Google Search results)
# Get your API key at: https://serpapi.com/
SERPAPI_KEY=

# Brave Search API Key (alternative search API)
# Get your API key at: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# NewsAPI Key (for news headlines)
# Get your free API key at: https://newsapi.org/
NEWSAPI_KEY=

# CoinGecko API (free tier available)
# Used for crypto prices - no key required for basic usage
COINGECKO_API_KEY=
