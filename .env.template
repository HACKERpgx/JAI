# JAI Assistant Configuration Template
# Copy this file to .env and fill in your API keys

# ============================================
# AUTHENTICATION (Supabase)
# ============================================

# Supabase Project URL
# Get yours at: https://supabase.com/
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon/Public Key
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase JWT Secret (for server-side verification)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# If standalone SQLite/MFA auth is enabled, set a unique long random value here.
# Keep it in the hosting provider's secret store; do not commit the real value.
JAI_SECRET_KEY=
SESSION_SECURE_COOKIES=true

# Explicit browser origins only; never use * when credentials are enabled.
JAI_CORS_ORIGINS=https://j-ai.top,https://www.j-ai.top

# ============================================
# REQUIRED API KEYS
# ============================================

# OpenAI API Key (via OpenRouter)
# Get yours at: https://openrouter.ai/
OPENAI_API_KEY=your_openrouter_api_key_here

# ============================================
# OPTIONAL API KEYS
# ============================================

# OpenWeather API Key
# Get yours at: https://openweathermap.org/api
# (A default key is provided, but get your own for production)
OPENWEATHER_API_KEY=your_weather_api_key_here

# News API Key
# Get yours at: https://newsapi.org/
NEWS_API_KEY=your_news_api_key_here

# ============================================
# SPEECH SETTINGS
# ============================================

# Enable spoken responses (true/false, yes/no, 1/0, on/off)
SPEAK_RESPONSES=false

# Preferred TTS voice (leave empty for default)
# Common Windows voices: David, Zira, Mark, Hazel
# Run test_tts.py to see available voices on your system
TTS_VOICE=

# ============================================
# VOICE CLIENT SETTINGS (for voice_client.py)
# ============================================

# JAI server URL (if running voice client separately)
JAI_SERVER=http://localhost:8000

# Optional voice-client credentials; configure unique values before use.
JAI_USERNAME=
JAI_PASSWORD=

# Wake word for voice activation
WAKE_WORD=hey jai

# ============================================
# ADVANCED SETTINGS (Optional)
# ============================================

# Default language for responses (en, hi, ur, ar, ru, es)
# DEFAULT_LANGUAGE=en

# Cache duration for weather data (seconds)
# CACHE_DURATION=600
